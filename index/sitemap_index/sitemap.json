{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "page_text": {
          "type": "custom",
          "char_filter": ["html_strip"],
          "tokenizer": "standard",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "title": {
        "type": "text",
        "analyzer": "page_text",
        "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
      },
      "content": {
        "type": "text",
        "analyzer": "page_text"
      },
      "url": {
        "type": "keyword",
        "index": false,
        "doc_values": false
      }
    }
  }
}
